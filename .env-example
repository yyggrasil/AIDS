# ==============================================================================
# AIDS: Autonomous Intrusion Detection System - Training Configuration (Example)
# Copie este arquivo para '.env' para configurar o treinamento dos modelos (main.py)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Modelos Base do Stacking Ensemble (Nível 0)
# ------------------------------------------------------------------------------
TRAIN_LINEARSVC=True
TRAIN_DT=True
TRAIN_RF=True
TRAIN_ET=False
TRAIN_HGB=False
TRAIN_MLP=True

# ------------------------------------------------------------------------------
# 2. Configurações do Meta-Classificador Stacking (Nível 1)
# ------------------------------------------------------------------------------
TRAIN_STACKING=True

# Perfil do Stacking:
# - 'edge': Otimizado para Raspberry Pi 3/4 (LinearSVC Calibrado + HistGradientBoosting + RandomForest)
# - 'balanced': LinearSVC + RandomForest + ExtraTrees + HistGradientBoosting
# - 'performance': LinearSVC + RandomForest + ExtraTrees + HistGradientBoosting + MLP
# - 'legacy': LinearSVC + RandomForest + ExtraTrees + DecisionTree
STACKING_PROFILE=edge

STACKING_CV_SPLITS=5
STACKING_PASSTHROUGH=False
STACKING_N_JOBS=2

# ------------------------------------------------------------------------------
# 3. Modos de Treinamento e Alvo (Target)
# ------------------------------------------------------------------------------
RUN_BINARY=True
RUN_MULTICLASS=False

# ------------------------------------------------------------------------------
# 4. Amostragem do Dataset (data/CICFlowMeter_out.csv)
# ------------------------------------------------------------------------------
# Fração de amostragem estratificada do dataset (0.01 = 1%, 0.1 = 10%, 1.0 = 100%)
SAMPLE_FRAC=0.1
