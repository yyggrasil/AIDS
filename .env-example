# ==============================================================================
# AIDS: Autonomous Intrusion Detection System - Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Pipeline de Machine Learning & Treinamento (main.py)
# ------------------------------------------------------------------------------
TRAIN_LINEARSVC=True
TRAIN_DT=True
TRAIN_RF=True
TRAIN_ET=False
TRAIN_HGB=False
TRAIN_MLP=True
TRAIN_STACKING=True

# Configurações do Stacking Ensemble
# Perfis disponíveis: edge (padrão RPi), balanced, performance, legacy
STACKING_PROFILE=edge
# Número de splits para StratifiedKFold out-of-fold (padrão: 5)
STACKING_CV_SPLITS=5
# Concatenar atributos de entrada com meta-features? (True/False)
STACKING_PASSTHROUGH=False
# Paralelismo no Stacking (padrão seguro: 2 para evitar OOM Killer / pressão de RAM no Linux)
STACKING_N_JOBS=2

# Modos de Treinamento
RUN_BINARY=True
RUN_MULTICLASS=True

# Fração de amostragem do dataset (0.1 = 10%, 1.0 = 100%)
SAMPLE_FRAC=0.1

# ------------------------------------------------------------------------------
# 2. Configurações de Monitoramento de Rede no Raspberry Pi (rpi_monitor.py)
# ------------------------------------------------------------------------------
# Interface de rede para captura de pacotes (ex: eth0, wlan0, any, end0)
NETWORK_INTERFACE=eth0

# Modo de detecção em tempo real: binary ou multiclass
DETECTION_MODE=binary

# Limiar de probabilidade para classificar como ataque (0.0 a 1.0)
ALERT_THRESHOLD=0.50

# Timeout de inatividade do fluxo em segundos (após o qual é classificado)
FLOW_INACTIVITY_TIMEOUT=10.0

# Timeout máximo de duração do fluxo em segundos
FLOW_ACTIVE_TIMEOUT=60.0

# Modo de teste sem envio real de e-mails (True/False)
DRY_RUN=False

# Arquivo de log opcional
LOG_FILE=logs/aids_rpi.log

# ------------------------------------------------------------------------------
# 3. Configurações de Alerta por E-mail (SMTP Seguro / TLS / SSL)
# ------------------------------------------------------------------------------
# Habilitar envio de alertas por e-mail (True/False)
ALERT_EMAIL_ENABLED=True

# Servidor SMTP (Ex: smtp.gmail.com, smtp-mail.outlook.com, smtp.mail.yahoo.com)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Utilizar STARTTLS (porta 587) ou SSL direto (porta 465)
SMTP_USE_TLS=True
SMTP_USE_SSL=False

# Credenciais SMTP (Para Gmail, use a 'Senha de App' de 16 dígitos)
SMTP_USER=seu_email@gmail.com
SMTP_PASS=sua_senha_de_app_aqui

# Remetente e Destinatário(s) dos alertas (múltiplos separados por vírgula)
ALERT_SENDER=aids-rpi@antigravity.local
ALERT_RECIPIENT=admin_seguranca@empresa.com,soc@empresa.com

# ------------------------------------------------------------------------------
# 4. Anti-Flood & Throttling
# ------------------------------------------------------------------------------
# Intervalo de cooldown em segundos para suprimir e-mails repetidos do mesmo IP
COOLDOWN_SECONDS=60.0
