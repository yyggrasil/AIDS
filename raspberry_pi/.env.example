# ==============================================================================
# AIDS-RPi: Configurações de Monitoramento de Rede em Tempo Real no Raspberry Pi
# ==============================================================================

# Interface de Rede (eth0, wlan0, end0, any)
NETWORK_INTERFACE=eth0

# Modo de Detecção: 'binary' (Maligno vs Benigno) ou 'multiclass' (Tipos de Ataque)
DETECTION_MODE=binary

# Limiar de Probabilidade de Ataque (0.0 a 1.0)
ALERT_THRESHOLD=0.50

# Timeouts de Fluxo (em segundos)
FLOW_INACTIVITY_TIMEOUT=10.0
FLOW_ACTIVE_TIMEOUT=60.0

# Modo Simulação (True = não envia e-mails reais, False = envia alertas reais)
DRY_RUN=False

# ==============================================================================
# Configurações de Alerta por E-mail (SMTP Seguro)
# ==============================================================================
ALERT_EMAIL_ENABLED=True
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=True
SMTP_USE_SSL=False
SMTP_USER=seu_email@gmail.com
SMTP_PASS=sua_senha_de_aplicativo_16_digitos
ALERT_SENDER=aids-rpi@antigravity.local
ALERT_RECIPIENT=soc@empresa.com,admin@empresa.com

# Intervalo Mínimo de Cooldown Anti-Flood por IP / Ataque (em segundos)
COOLDOWN_SECONDS=60.0

# Caminho opcional do arquivo de log
LOG_FILE=raspberry_pi/aids_rpi.log
