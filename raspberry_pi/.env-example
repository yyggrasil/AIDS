# ==============================================================================
# AIDS-RPi: Edge Intrusion Detection System - Raspberry Pi 3 Configuration (Example)
# Copie este arquivo para 'raspberry_pi/.env' para configurar o monitoramento no RPi 3
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Configurações de Captura e Inferência no Raspberry Pi 3
# ------------------------------------------------------------------------------
# Interface de rede para captura de pacotes (ex: eth0 para cabo, wlan0 para Wi-Fi)
NETWORK_INTERFACE=eth0

# Modo de classificação: 'binary' (recomendado para RPi 3 por menor latência) ou 'multiclass'
DETECTION_MODE=binary

# Limiar de probabilidade para classificar como ataque (0.0 a 1.0)
ALERT_THRESHOLD=0.50

# Timeout de inatividade do fluxo em segundos (fluxo sem pacotes é finalizado e avaliado)
FLOW_INACTIVITY_TIMEOUT=10.0

# Duração máxima contínua do fluxo em segundos antes de forçar classificação
FLOW_ACTIVE_TIMEOUT=60.0

# Modo de teste / simulação sem envio real de e-mails (True/False)
DRY_RUN=False

# Arquivo de log geral do serviço no Raspberry Pi
LOG_FILE=logs/aids_rpi.log

# ------------------------------------------------------------------------------
# 2. Alertas de Segurança por E-mail (SMTP Seguro TLS / SSL)
# ------------------------------------------------------------------------------
# Habilitar envio de alertas por e-mail (True/False)
ALERT_EMAIL_ENABLED=True

# Servidor SMTP e Porta
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Utilizar STARTTLS (porta 587) ou SSL direto (porta 465)
SMTP_USE_TLS=True
SMTP_USE_SSL=False

# Credenciais SMTP (Para Gmail, use a 'Senha de App' de 16 dígitos)
SMTP_USER=seu_email@gmail.com
SMTP_PASS=sua_senha_de_app_aqui

# Remetente e Destinatários dos alertas (separados por vírgula)
ALERT_SENDER=aids-rpi@antigravity.local
ALERT_RECIPIENT=admin_seguranca@empresa.com,soc@empresa.com

# ------------------------------------------------------------------------------
# 3. Proteção Anti-Flood & Cooldown
# ------------------------------------------------------------------------------
# Intervalo de cooldown em segundos para suprimir e-mails repetidos da mesma ameaça
COOLDOWN_SECONDS=60.0

# ------------------------------------------------------------------------------
# 4. Sistema de Log de Pacotes e Intrusões Detectadas (Audit Trail)
# ------------------------------------------------------------------------------
# Habilitar gravação persistente das detecções em disco
DETECTION_LOG_ENABLED=True

# Caminho do arquivo de log de detecções
DETECTION_LOG_FILE=logs/detections.jsonl

# Formato do log: jsonl (padrão SIEM), csv (planilhas), text (syslog) ou all
DETECTION_LOG_FORMAT=jsonl

# Tamanho máximo por arquivo antes da rotação (5 MB otimizado para o MicroSD do RPi 3)
DETECTION_LOG_MAX_BYTES=5242880

# Quantidade de arquivos de backup rotacionados a manter (.1, .2, ...)
DETECTION_LOG_BACKUP_COUNT=3

# Gravar todos os fluxos avaliados (True) ou apenas intrusões/ataques detectados (False)
DETECTION_LOG_ALL_FLOWS=False
